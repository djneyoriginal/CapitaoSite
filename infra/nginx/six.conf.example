server {
    server_name www.capitao.tec.br capitao.tec.br;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 32m;

    location = /imprensa {
        return 301 /imprensa/;
    }

    location /imprensa/ {
        proxy_pass http://127.0.0.1:3001/imprensa/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /xis {
        return 301 /xis/;
    }

    location /xis/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate <CONFIGURE_CERTIFICATE_PATH>; # managed by Certbot
    ssl_certificate_key <CONFIGURE_CERTIFICATE_PATH>; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
    include /etc/nginx/snippets/capitao-ia.conf;



}
server {
    if ($host = www.capitao.tec.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = capitao.tec.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name www.capitao.tec.br capitao.tec.br;

    root /usr/share/nginx/html;
    index index.html;

    location = /imprensa {
        return 301 /imprensa/;
    }

    location /imprensa/ {
        proxy_pass http://127.0.0.1:3001/imprensa/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /xis {
        return 301 /xis/;
    }

    location /xis/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = / {
        try_files /index.html =404;
    }


}
